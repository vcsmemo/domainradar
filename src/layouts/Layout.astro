---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
}

const { 
  title = "NicheDomainRadar · Clean High DR Expired Domains Finder & Pending Delete List", 
  description = "Discover clean high DR expired domains with quality backlinks. Daily radar feed of .ai, .com, .io expired domains, pending delete lists, and backlink audit for indie builders & SEOs.",
  keywords = "expired domains, high dr expired domains, clean expired domains, expired domain finder, pending delete list, expired .ai domains, SEO expired domains with backlinks"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://nichedomainradar.pages.dev');

// Schema.org DataFeed JSON-LD Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "DataFeed",
  "name": "NicheDomainRadar - High DR Clean Expired Domain Finder",
  "description": description,
  "url": canonicalURL.toString(),
  "keywords": keywords,
  "provider": {
    "@type": "Organization",
    "name": "NicheDomainRadar",
    "url": "https://nichedomainradar.pages.dev"
  }
};
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Targeted SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / Twitter Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts for Modern Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- JSON-LD Structured Data Injection -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="bg-[#080b08] text-slate-200 antialiased min-h-screen flex flex-col font-mono selection:bg-emerald-500 selection:text-black">
    
    <!-- Header Navigation -->
    <header class="border-b border-[#182318] bg-[#0c120c]/80 backdrop-blur sticky top-0 z-40">
      <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-2 font-mono font-bold text-lg text-white tracking-tight">
          <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>NicheDomain<span class="text-emerald-400">Radar</span></span>
        </a>

        <nav class="hidden md:flex items-center gap-6 text-xs text-slate-300 font-mono">
          <a href="/" class="hover:text-emerald-400 transition-colors">Expired Domains Feed</a>
          <a href="/archive" class="hover:text-emerald-400 transition-colors flex items-center gap-1">
            <span>Pending Delete Vault</span>
            <span class="bg-emerald-950 text-emerald-400 text-[10px] px-1.5 py-0.5 rounded border border-emerald-500/30">Pro</span>
          </a>
          <a href="#feed" class="hover:text-emerald-400 transition-colors">High DR Radar</a>
          <a href="#pricing" class="hover:text-emerald-400 transition-colors">Pricing ($19/mo)</a>
        </nav>

        <div class="flex items-center gap-3 font-mono">
          <a href="#pricing" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-3 py-1.5 rounded text-xs transition-all shadow-md shadow-emerald-500/20">
            Get Pro Access ($19)
          </a>
        </div>

      </div>
    </header>

    <!-- Main Page Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer with Compliance & Legal Links -->
    <footer class="border-t border-[#182318] bg-[#090d09] py-8 text-center text-xs text-slate-500 font-mono">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          © 2026 NicheDomainRadar. Premium Clean Expired Domains & Pending Delete Finder for SEO.
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <a href="/" class="hover:text-emerald-400">Expired Domains</a>
          <a href="/archive" class="hover:text-emerald-400">Pending Delete List</a>
          <a href="/privacy" class="hover:text-emerald-400">Privacy Policy</a>
          <a href="/terms" class="hover:text-emerald-400">Terms of Service</a>
          <a href="/sitemap.xml" class="hover:text-emerald-400">Sitemap.xml</a>
          <a href="#pricing" class="hover:text-emerald-400">Pricing</a>
        </div>
      </div>
    </footer>

  </body>
</html>
