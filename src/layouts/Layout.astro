---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "NicheDomainRadar · Daily Curated Clean High-DR Expired Domains",
  description = "The daily radar of clean, high-authority expired domains for indie hackers, SaaS builders, and SEO agencies. Verified zero-penalty history with top backlinks.",
  image = "https://niche-domain-radar.pages.dev/og-image.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://niche-domain-radar.pages.dev');

// Schema.org Structured Data (JSON-LD) for Google Rich Snippets
const schemaData = {
  "@context": "https://schema.org",
  "@type": "DataFeed",
  "name": "NicheDomainRadar Daily Clean Expired Domains",
  "description": description,
  "url": "https://niche-domain-radar.pages.dev",
  "provider": {
    "@type": "Organization",
    "name": "NicheDomainRadar",
    "url": "https://niche-domain-radar.pages.dev"
  }
};
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Google Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#080b08] text-[#e2e8e2] font-sans antialiased min-h-screen flex flex-col selection:bg-emerald-500/30 selection:text-emerald-200">
    
    <!-- Top Bar Navigation -->
    <header class="border-b border-[#1b261b] bg-[#080b08]/90 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 font-bold tracking-tight text-white hover:opacity-90 transition-opacity">
          <span class="w-3 h-3 rounded-full bg-emerald-400 shadow-[0_0_8px_#00ff66]"></span>
          <span class="font-mono tracking-tight text-base text-white">NicheDomain<span class="text-emerald-400">Radar</span></span>
        </a>

        <div class="flex items-center gap-4 text-xs font-mono">
          <a href="/#feed" class="text-slate-400 hover:text-white transition-colors">Daily Radar</a>
          <a href="/#pricing" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-3 py-1.5 rounded transition-all">
            Unlock Pro ($29/mo)
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#1b261b] bg-[#050805] py-10 text-xs font-mono text-slate-500">
      <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <span class="text-white font-bold">NicheDomainRadar</span> — Daily Curated Clean Expired Domains.
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <a href="/sitemap.xml" class="hover:text-emerald-400">Sitemap</a>
          <span class="text-slate-700">·</span>
          <a href="/#pricing" class="hover:text-emerald-400">Pro Membership</a>
          <span class="text-slate-700">·</span>
          <a href="mailto:support@nichedomainradar.com" class="hover:text-emerald-400">Contact / API</a>
        </div>
      </div>
    </footer>

  </body>
</html>
